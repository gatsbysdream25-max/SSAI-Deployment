# Template: deploy/install.sh fills in @DIR@, @USER@, @PORT@ and @BIND@. Do not install or edit this file by hand.
[Unit]
Description=SwarmSentinel API and dashboard
After=network.target

[Service]
User=@USER@
WorkingDirectory=@DIR@/backend
Environment=DATA_DIR=@DIR@
Environment=PYTHONPATH=@DIR@/backend
# One worker, 8 threads (2026-11-15): each extra worker is a full copy of the app in RAM; the dashboard is mostly waiting on I/O,
# so threads serve it as well. One worker also means one process counts the automatic-response hourly cap.
ExecStart=@DIR@/swarmsentinel-env/bin/gunicorn -w 1 --threads 8 --worker-class gthread -b @BIND@:@PORT@ --timeout 60 app:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

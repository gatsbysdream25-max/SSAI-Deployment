# nginx in front of the hub (see README.md). Replace the host name and certificate paths.
server {
    listen 80;
    server_name ssai.bank.example;
    return 301 https://$host$request_uri;           # nothing is served in plain text
}

server {
    listen 443 ssl;
    server_name ssai.bank.example;

    ssl_certificate     /etc/ssl/ssai/ssai.bank.example.crt;
    ssl_certificate_key /etc/ssl/ssai/ssai.bank.example.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 16m;                        # the hub refuses larger bodies itself

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;      # replace, never append: a client's own header is not trusted
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

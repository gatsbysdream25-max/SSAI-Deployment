#cloud-config
# VirtualBox unattended-install template for the SwarmSentinel sandbox VM (deploy/sandbox/create-virtualbox-vm.ps1).
# Based on VirtualBox 7.2's ubuntu_autoinstall_user_data; the additions are marked SSAI: an SSH server, key-only login
# with the key the create script passes in, and the few packages a fresh SwarmSentinel install needs.
autoinstall:
  version: 1

  apt:
    fallback: offline-install

  locale: @@VBOX_INSERT_LOCALE@@
  keyboard:
    layout: us

  shutdown: reboot

  storage:
    layout:
      name: direct
    swap:
      size: 0

@@VBOX_COND_HAS_PROXY@@
  proxy: @@VBOX_INSERT_PROXY@@
@@VBOX_COND_END@@

  # SSAI: reachable over SSH with a key only (no password logins over the network).
  ssh:
    install-server: true
    allow-pw: false

  # SSAI: what deploy/install.sh expects on a fresh machine, plus what the drills use (rsyslog, ufw).
  packages:
    - python3-venv
    - git
    - curl
    - ufw
    - rsyslog
    - nmap
    - iproute2

  late-commands:
    - cp /cdrom/vboxpostinstall.sh /target/root/vboxpostinstall.sh
    - chmod +x /target/root/vboxpostinstall.sh
    - curtin in-target --target=/target -- /bin/bash /root/vboxpostinstall.sh --direct

  user-data:
    hostname: '@@VBOX_INSERT_HOSTNAME_WITHOUT_DOMAIN@@'
    users:
      - name: '@@VBOX_INSERT_USER_LOGIN@@'
        gecos: '@@VBOX_INSERT_USER_LOGIN@@'
        primary_group: '@@VBOX_INSERT_USER_LOGIN@@'
        groups: sudo
        # SSAI: passwordless sudo, so setup and drills run over SSH. A throwaway sandbox only, never a customer box.
        sudo: 'ALL=(ALL) NOPASSWD:ALL'
        lock-passwd: false
        shell: /bin/bash
        passwd: '@@VBOX_INSERT_USER_PASSWORD_SHACRYPT512@@'
        # SSAI: the create script appends the key here (see create-virtualbox-vm.ps1)
        ssh_authorized_keys:
          - '@@SSAI_PUBLIC_KEY@@'

@@VBOX_COND_IS_RTC_USING_UTC@@
    timezone: Etc/UTC
@@VBOX_COND_END@@
@@VBOX_COND_IS_NOT_RTC_USING_UTC@@
    timezone: @@VBOX_INSERT_TIME_ZONE_UX@@
@@VBOX_COND_END@@

    ntp:
        enabled: true
